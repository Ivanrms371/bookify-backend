generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                 String              @id @default(dbgenerated("uuidv7()")) @db.Uuid
  name               String
  email              String              @unique
  emailVerifiedAt    DateTime?           @map("email_verified_at")
  phone              String?
  phoneVerifiedAt    DateTime?           @map("phone_verified_at")
  password           String?
  avatarUrl          String?             @map("avatar_url")
  ipAddress          String?             @map("ip_address")
  userAgent          String?             @map("user_agent")
  googleId           String?             @unique @map("google_id")
  lastLoginAt        DateTime?           @map("last_login_at")
  tokenVersion       Int                 @default(0) @map("token_version")
  createdAt          DateTime            @default(now()) @map("created_at")
  updatedAt          DateTime            @updatedAt @map("updated_at")
  businessMembers    BusinessMember[]
  business           Business?
  inAppNotifications InAppNotification[]
  invites            MemberInvite[]
  platformAdmin      PlatformAdmin?
  sessions           Session[]
  staff              Staff?
  verificationLocks  VerificationLock?
  verifications      Verification[]

  @@index([email])
  @@index([phone])
  @@index([googleId])
  @@map("users")
}

model BusinessMember {
  id         String       @id @default(dbgenerated("uuidv7()")) @db.Uuid
  businessId String       @map("business_id") @db.Uuid
  userId     String       @map("user_id") @db.Uuid
  role       BusinessRole
  createdAt  DateTime     @default(now()) @map("created_at")
  updatedAt  DateTime     @updatedAt @map("updated_at")
  business   Business     @relation(fields: [businessId], references: [id], onDelete: Cascade)
  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, businessId])
  @@index([businessId])
  @@index([userId])
  @@map("business_members")
}

model Session {
  id         String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  jti        String    @unique
  deviceId   String    @map("device_id")
  ipAddress  String?   @map("ip_address")
  userAgent  String?   @map("user_agent")
  lastUsedAt DateTime? @default(now()) @map("last_used_at")
  revokedAt  DateTime? @map("revoked_at")
  expiresAt  DateTime  @map("expires_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, deviceId])
  @@index([revokedAt])
  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model Verification {
  id          String           @id @default(dbgenerated("uuidv7()")) @db.Uuid
  type        VerificationType
  userId      String           @map("user_id") @db.Uuid
  address     String
  tokenHash   String?          @unique @map("token_hash")
  codeHash    String?          @map("code_hash")
  attempts    Int              @default(0)
  maxAttempts Int              @default(3) @map("max_attempts")
  expiresAt   DateTime         @map("expires_at")
  verifiedAt  DateTime?        @map("verified_at")
  lockedAt    DateTime?        @map("locked_at")
  createdAt   DateTime         @default(now()) @map("created_at")
  sentCount   Int              @default(0) @map("sent_count")
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([address])
  @@index([tokenHash])
  @@map("verifications")
}

model VerificationLock {
  id          String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId      String   @unique @map("user_id") @db.Uuid
  address     String
  lockedUntil DateTime @map("locked_until")
  reason      String?  @map("reason")
  createdAt   DateTime @default(now()) @map("created_at")
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([address])
  @@map("verification_locks")
}

model Business {
  id                  String                 @id @default(dbgenerated("uuidv7()")) @db.Uuid
  ownerId             String                 @unique @map("owner_id") @db.Uuid
  name                String?
  slug                String?                @unique
  type                BusinessType?
  description         String?
  addressLine1        String?                @map("address_line_1")
  addressLine2        String?                @map("address_line_2")
  phone               String?
  logoUrl             String?                @map("logo_url")
  logoPublicId        String?                @map("logo_public_id")
  coverUrl            String?                @map("cover_url")
  coverPublicId       String?                @map("cover_public_id")
  onboardingStep      Int                    @default(1) @map("onboarding_step")
  onboardingCompleted Boolean                @default(false) @map("onboarding_completed")
  createdAt           DateTime               @default(now()) @map("created_at")
  updatedAt           DateTime               @updatedAt @map("updated_at")
  deletedAt           DateTime?              @map("deleted_at")
  isActive            Boolean                @default(false) @map("is_active")
  appointments        Appointment[]
  dailyStats          BusinessDailyStats[]
  lifetimeStats       BusinessLifetimeStats?
  limits              BusinessLimits?
  members             BusinessMember[]
  settings            BusinessSettings?
  owner               User                   @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  customers           Customer[]
  inAppNotifications  InAppNotification[]
  memberInvites       MemberInvite[]
  payments            Payment[]
  scheduleExceptions  ScheduleException[]
  services            Service[]
  staffs              Staff[]
  subscription        Subscription?
  workingHours        WorkingHours[]

  @@index([ownerId])
  @@map("businesses")
}

model BusinessSettings {
  id                        String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  businessId                String   @unique @map("business_id") @db.Uuid
  slotIntervalMinutes       Int      @default(30) @map("slot_interval_minutes")
  maxAdvancedDays           Int      @default(30) @map("max_advanced_days")
  minAdvancedMinutes        Int      @default(30) @map("min_advanced_minutes")
  bufferTimeMinutes         Int      @default(0) @map("buffer_time_minutes")
  cancellationWindowMinutes Int      @default(30) @map("cancellation_window_minutes")
  timezone                  String   @default("America/Montevideo")
  currency                  String   @default("UYU")
  maxPendingApptsPerClient  Int      @default(10) @map("max_pending_appts_per_client")
  requireConfirmation       Boolean  @default(false) @map("require_confirmation")
  holidayClosureAutoApply   Boolean  @default(false) @map("holiday_closure_auto_apply")
  allowPassiveTimeBooking   Boolean  @default(true) @map("allow_passive_time_booking")
  business                  Business @relation(fields: [businessId], references: [id])

  @@map("business_settings")
}

model Service {
  id                   String              @id @default(dbgenerated("uuidv7()")) @db.Uuid
  businessId           String              @map("business_id") @db.Uuid
  name                 String
  image                String?
  description          String?
  price                Decimal             @db.Decimal(10, 2)
  discountPercentage   Int?                @default(0) @map("discount_percentage")
  discountFixed        Decimal?            @default(0) @map("discount_fixed") @db.Decimal(10, 2)
  initialActiveMinutes Int                 @map("initial_active_minutes")
  passiveTimeMinutes   Int                 @default(0) @map("passive_time_minutes")
  finalActiveMinutes   Int                 @default(0) @map("final_active_minutes")
  durationMinutes      Int                 @map("duration_minutes")
  isActive             Boolean             @default(true) @map("is_active")
  displayOrder         Int                 @default(0) @map("display_order")
  createdAt            DateTime            @default(now()) @map("created_at")
  updatedAt            DateTime            @updatedAt @map("updated_at")
  deletedAt            DateTime?           @map("deleted_at")
  appointments         Appointment[]
  assignments          ServiceAssignment[]
  business             Business            @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId])
  @@map("services")
}

model ServiceAssignment {
  staffId   String  @map("staff_id") @db.Uuid
  serviceId String  @map("service_id") @db.Uuid
  isActive  Boolean @default(true) @map("is_active")
  service   Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  staff     Staff   @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@id([staffId, serviceId])
  @@index([staffId, isActive])
  @@map("service_assigments")
}

model Staff {
  id                  String              @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId              String              @unique @map("user_id") @db.Uuid
  businessId          String              @map("business_id") @db.Uuid
  slotIntervalMinutes Int                 @default(30) @map("slot_interval_minutes")
  maxAdvancedDays     Int                 @default(30) @map("max_advanced_days")
  minAdvancedMinutes  Int                 @default(30) @map("min_advanced_minutes")
  title               String?
  bio                 String?
  avatarUrl           String?             @map("avatar_url")
  avatarPublicId      String?             @map("avatar_public_id")
  isActive            Boolean             @default(true) @map("is_active")
  displayName         String              @map("display_name")
  displayOrder        Int                 @default(0) @map("display_order")
  createdAt           DateTime            @default(now()) @map("created_at")
  updatedAt           DateTime            @updatedAt @map("updated_at")
  deletedAt           DateTime?           @map("deleted_at")
  colorTheme          String?             @map("color_theme")
  commissionPercent   Decimal?            @default(0) @map("commission_percent") @db.Decimal(10, 2)
  appointments        Appointment[]
  exceptions          ScheduleException[]
  assignments         ServiceAssignment[]
  lifetimeStats       StaffLifetimeStats?
  stats               StaffDailyStats[]
  business            Business            @relation(fields: [businessId], references: [id], onDelete: Cascade)
  user                User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  workingHours        WorkingHours[]

  @@unique([userId, businessId])
  @@index([businessId])
  @@map("staffs")
}

model MemberInvite {
  id         String       @id @default(dbgenerated("uuidv7()")) @db.Uuid
  email      String
  businessId String       @map("business_id") @db.Uuid
  inviterId  String       @map("inviter_id") @db.Uuid
  token      String       @unique
  expiresAt  DateTime     @map("expires_at")
  acceptedAt DateTime?    @map("accepted_at")
  role       BusinessRole @default(STAFF)
  business   Business     @relation(fields: [businessId], references: [id], onDelete: Cascade)
  inviter    User         @relation(fields: [inviterId], references: [id])

  @@index([email])
  @@map("member_invites")
}

model WorkingHours {
  id           String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  businessId   String   @map("business_id") @db.Uuid
  dayOfWeek    Int      @map("day_of_week")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  staffId      String?  @map("staff_id") @db.Uuid
  endMinutes   Int      @map("end_minutes")
  startMinutes Int      @map("start_minutes")
  business     Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  staff        Staff?   @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@index([staffId, dayOfWeek])
  @@index([businessId, dayOfWeek])
  @@index([staffId])
  @@map("working_hours")
}

model ScheduleException {
  id         String                   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  businessId String                   @map("business_id") @db.Uuid
  isClosed   Boolean                  @map("is_closed")
  reason     String?
  createdAt  DateTime                 @default(now()) @map("created_at")
  daysOfWeek Int[]                    @map("days_of_week")
  endDate    DateTime                 @map("end_date")
  staffId    String                   @map("staff_id") @db.Uuid
  startDate  DateTime                 @map("start_date")
  blocks     ScheduleExceptionBlock[]
  business   Business                 @relation(fields: [businessId], references: [id], onDelete: Cascade)
  staff      Staff                    @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@index([staffId])
  @@index([staffId, startDate, endDate])
  @@map("schedule_exceptions")
}

model ScheduleExceptionBlock {
  id                  String            @id @default(dbgenerated("uuidv7()")) @db.Uuid
  scheduleExceptionId String            @map("schedule_exception_id") @db.Uuid
  startMinutes        Int               @map("start_minutes")
  endMinutes          Int               @map("end_minutes")
  createdAt           DateTime          @default(now()) @map("created_at")
  scheduleException   ScheduleException @relation(fields: [scheduleExceptionId], references: [id], onDelete: Cascade)

  @@index([scheduleExceptionId])
  @@map("schedule_exception_blocks")
}

model Customer {
  id                    String        @id @default(dbgenerated("uuidv7()")) @db.Uuid
  businessId            String        @map("business_id") @db.Uuid
  phone                 String
  phoneCountryCode      String        @default("+598") @map("phone_country_code")
  phoneVerified         Boolean       @default(false) @map("phone_verified")
  email                 String?
  emailVerified         Boolean       @default(false) @map("email_verified")
  emailBounced          Boolean       @default(false) @map("email_bounced")
  acceptsWhatsapp       Boolean       @default(true) @map("accepts_whatsapp")
  acceptsEmail          Boolean       @default(true) @map("accepts_email")
  preferredLanguage     String        @default("es") @map("preferred_language")
  notes                 String?
  internalNotes         String?       @map("internal_notes")
  firstAppointmentAt    DateTime?     @map("first_appointment_at")
  lastAppointmentAt     DateTime?     @map("last_appointment_at")
  totalAppointments     Int           @default(0) @map("total_appointments")
  completedAppointments Int           @default(0) @map("completed_appointments")
  cancelledAppointments Int           @default(0) @map("cancelled_appointments")
  noShowCount           Int           @default(0) @map("no_show_count")
  totalSpent            Float         @default(0) @map("total_spent")
  blockedReason         String?       @map("blocked_reason")
  blockedAt             DateTime?     @map("blocked_at")
  createdAt             DateTime      @default(now()) @map("created_at")
  updatedAt             DateTime      @updatedAt @map("updated_at")
  deletedAt             DateTime?     @map("deleted_at")
  name                  String
  nextAppointmentAt     DateTime?     @map("next_appointment_at")
  appointments          Appointment[]
  business              Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([businessId, phone])
  @@index([businessId])
  @@index([email])
  @@index([lastAppointmentAt])
  @@map("customers")
}

model Appointment {
  id                   String            @id @default(dbgenerated("uuidv7()")) @db.Uuid
  businessId           String            @map("business_id") @db.Uuid
  serviceId            String            @map("service_id") @db.Uuid
  customerId           String            @map("customer_id") @db.Uuid
  staffId              String            @map("staff_id") @db.Uuid

  startTime            DateTime          @map("start_time")
  status               AppointmentStatus @default(CONFIRMED)
  customerName         String            @map("customer_name")
  customerPhone        String            @map("customer_phone")
  customerEmail        String?           @map("customer_email")
  notes                String?
  internalNotes        String?           @map("internal_notes")
  confirmationCode     String            @map("confirmation_code")

  rescheduleToken      String?           @unique @map("reschedule_token")
  rescheduleRequestedAt DateTime?         @map("reschedule_requested_at")
  previousStartTime    DateTime?         @map("previous_start_time")
  previousEndTime      DateTime?         @map("previous_end_time")
  rescheduleReason     String?           @map("reschedule_reason")
  rescheduleCount      Int               @default(0) @map("reschedule_count")

  cancelledAt          DateTime?         @map("cancelled_at")
  cancellationReason   String?           @map("cancellation_reason")
  cancelToken          String?           @unique @map("cancel_token")

  createdAt            DateTime          @default(now()) @map("created_at")
  updatedAt            DateTime          @updatedAt @map("updated_at")
  discountFixed        Decimal?          @default(0) @map("discount_fixed") @db.Decimal(10, 2)
  discountPercentage   Int?              @default(0) @map("discount_percentage")
  durationMinutes      Int               @map("duration_minutes")
  finalActiveMinutes   Int               @map("final_active_minutes")
  initialActiveMinutes Int               @map("initial_active_minutes")
  passiveMinutes       Int               @map("passive_minutes")
  price                Decimal           @db.Decimal(10, 2)
  endTime              DateTime          @map("end_time")
  business             Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customer             Customer          @relation(fields: [customerId], references: [id])
  service              Service           @relation(fields: [serviceId], references: [id])
  staff                Staff             @relation(fields: [staffId], references: [id])
  blocks AppointmentBlock[]

  @@unique([businessId, confirmationCode])
  @@index([businessId, staffId, startTime, endTime])
  @@index([businessId, status])
  @@index([customerId])
  @@index([startTime, status])
  @@map("appointments")
}

model AppointmentBlock {
  id            String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  appointmentId String   @db.Uuid @map("appointment_id")
  staffId       String   @db.Uuid @map("staff_id")
  startTime     DateTime @map("start_time")
  endTime       DateTime @map("end_time")

  appointment   Appointment @relation(fields: [appointmentId], references: [id])

  @@index([appointmentId])
  @@index([staffId, startTime])
  @@map("appointment_blocks")
}

model BusinessDailyStats {
  id           String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  businessId   String   @map("business_id") @db.Uuid
  date         DateTime @db.Date
  appointments Int      @default(0)
  confirmed    Int      @default(0)
  cancelled    Int      @default(0)
  completed    Int      @default(0)
  noShow       Int      @default(0) @map("no_show")
  revenue      Decimal  @default(0) @db.Decimal(10, 2)
  customers    Int      @default(0)
  business     Business @relation(fields: [businessId], references: [id])

  @@unique([businessId, date])
  @@index([businessId, date])
  @@map("business_daily_stats")
}

model BusinessLifetimeStats {
  id                String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  businessId        String   @unique @map("business_id") @db.Uuid
  totalAppointments Int      @default(0) @map("total_appointments")
  totalRevenue      Decimal  @default(0) @map("total_revenue") @db.Decimal(10, 2)
  totalCustomers    Int      @default(0) @map("total_customers")
  cancellationRate  Decimal  @default(0) @map("cancellation_rate") @db.Decimal(5, 2)
  noShowRate        Decimal  @default(0) @map("no_show_rate") @db.Decimal(5, 2)
  business          Business @relation(fields: [businessId], references: [id])

  @@map("business_lifetime_stats")
}

model StaffDailyStats {
  id                String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  staffId           String   @map("staff_member_id") @db.Uuid
  date              DateTime @db.Date
  appointmentsCount Int      @default(0) @map("appointments_count")
  revenue           Decimal  @default(0) @db.Decimal(10, 2)
  mostSoldServiceId String?  @map("most_sold_service_id")
  newCustomersCount Int      @map("new_customers_count")
  staff             Staff    @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@unique([staffId, date])
  @@index([date, staffId])
  @@map("staff_stats")
}

model StaffLifetimeStats {
  id                String  @id @default(dbgenerated("uuidv7()")) @db.Uuid
  staffId           String  @unique @map("staff_member_id") @db.Uuid
  totalRevenue      Decimal @default(0) @map("total_revenue") @db.Decimal(12, 2)
  totalAppointments Int     @default(0) @map("total_appointments")
  noShowCount       Int     @default(0) @map("no_show_count")
  staff             Staff   @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@map("staff_lifetime_stats")
}

model Notification {
  id            String                 @id @default(dbgenerated("uuidv7()")) @db.Uuid
  businessId    String?                @map("business_id") @db.Uuid
  recipientId   String                 @map("recipient_id")
  recipientType RecipientType          @map("recipient_type")
  type          String
  
  payload       Json
  createdAt     DateTime               @default(now()) @map("created_at")
  updatedAt     DateTime               @updatedAt @map("updated_at")

  inApp         InAppNotification?
  deliveries    NotificationDelivery[]

  @@index([recipientId])
  @@index([businessId])
  @@map("notifications")
}

model NotificationDelivery {
  id             String              @id @default(dbgenerated("uuidv7()")) @db.Uuid
  notificationId String              @map("notification_id") @db.Uuid
  referenceId    String?             @map("reference_id")

  channel        NotificationChannel
  status         NotificationStatus  @default(PENDING)
  errorMessage   String?             @map("error_message")

  sentAt         DateTime?           @map("sent_at")
  runAt          DateTime?           @map("run_at")
  retryCount     Int                 @default(0) @map("retry_count")

  notification   Notification        @relation(fields: [notificationId], references: [id])
  logs           NotificationLog[]

  @@unique([notificationId, channel])
  @@index([notificationId])
  @@map("notification_deliveries")
}

model InAppNotification {
  id             String       @id @default(dbgenerated("uuidv7()")) @db.Uuid
  notificationId String       @unique @map("notification_id") @db.Uuid
  userId         String       @map("user_id") @db.Uuid
  businessId     String       @map("business_id") @db.Uuid
  title          String
  message        String
  actionUrl      String?      @map("action_url")
  type           String
  readAt         DateTime?    @map("read_at")
  createdAt      DateTime     @default(now()) @map("created_at")
  business       Business     @relation(fields: [businessId], references: [id])
  notification   Notification @relation(fields: [notificationId], references: [id])
  user           User         @relation(fields: [userId], references: [id])

  @@index([businessId])
  @@index([userId, readAt])
  @@map("in_app_notifications")
}

model NotificationLog {
  id           String               @id @default(dbgenerated("uuidv7()")) @db.Uuid
  status       NotificationStatus
  createdAt    DateTime             @default(now()) @map("created_at")
  errorMessage String?              @map("error_message")
  deliveryId   String?              @map("notification_id") @db.Uuid
  delivery     NotificationDelivery? @relation(fields: [deliveryId], references: [id])

  @@map("notification_logs")
}

model BusinessLimits {
  id                String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  businessId        String   @unique @map("business_id") @db.Uuid
  whatsappLimit     Int      @default(0) @map("whatsapp_limit")
  professionalLimit Int      @default(1) @map("professional_limit")
  whatsappCount     Int      @default(0) @map("whatsapp_count")
  emailCount        Int      @default(0) @map("email_count")
  whatsappCost      Decimal  @default(0) @map("whatsapp_cost") @db.Decimal(6, 4)
  periodMonth       Int      @map("period_month")
  periodYear        Int      @map("period_year")
  lastResetAt       DateTime @map("last_reset_at")
  updatedAt         DateTime @updatedAt @map("updated_at")
  appointmentCount  Int      @default(0) @map("appointment_count")
  appointmentLimit  Int      @default(-1) @map("appointment_limit")
  emailCost         Decimal  @default(0) @map("email_cost") @db.Decimal(6, 4)
  emailLimit        Int      @default(0) @map("email_limit")
  professionalCount Int      @default(0) @map("professional_count")
  business          Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId])
  @@map("business_limits")
}

model Subscription {
  id                 String             @id @default(dbgenerated("uuidv7()")) @db.Uuid
  businessId         String             @unique @map("business_id") @db.Uuid
  planId             String             @map("plan_id") @db.Uuid
  status             SubscriptionStatus @default(TRIAL)
  amount             Decimal            @db.Decimal(10, 2)
  currency           String             @default("USD")
  billingCycle       BillingCycle?      @map("billing_cycle")
  currentPeriodStart DateTime?          @map("current_period_start")
  currentPeriodEnd   DateTime?          @map("current_period_end")
  nextPaymentDate    DateTime?          @map("next_payment_date")
  trialEndsAt        DateTime?          @map("trial_ends_at")
  trialUsedAt        DateTime?          @map("trial_used_at")
  discountPercent    Int                @default(0) @map("discount_percent")
  discountAmount     Decimal            @default(0) @map("discount_amount")
  discountExpiresAt  DateTime?          @map("discount_expires_at")
  cancelledAt        DateTime?          @map("cancelled_at")
  cancelReason       String?            @map("cancel_reason")
  paymentMethod      String?            @map("payment_method")
  paymentProvider    String?            @map("payment_provider")
  externalId         String?            @map("external_id")
  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @updatedAt @map("updated_at")
  deletedAt          DateTime?          @map("deleted_at")
  payments           Payment[]
  business           Business           @relation(fields: [businessId], references: [id], onDelete: Cascade)
  plan               Plan               @relation(fields: [planId], references: [id])

  @@index([businessId, status])
  @@index([status, currentPeriodEnd])
  @@index([status, trialEndsAt])
  @@map("subscriptions")
}

model Plan {
  id                String         @id @default(dbgenerated("uuidv7()")) @db.Uuid
  name              String
  planType          PlanType       @default(FREE) @map("plan_type")
  billingCycle      BillingCycle?  @map("billing_cycle")
  trialDays         Int            @default(14) @map("trial_days")
  isActive          Boolean        @default(true) @map("is_active")
  isPublic          Boolean        @default(true) @map("is_public")
  description       String?
  price             Decimal        @db.Decimal(10, 2)
  currency          String         @default("UYU")
  duration          Int
  features          Json?
  createdAt         DateTime       @default(now()) @map("created_at")
  updatedAt         DateTime       @updatedAt @map("updated_at")
  externalReference String?        @unique @map("external_reference")
  limits            PlanLimits?
  stats             PlanStats[]
  subscriptions     Subscription[]

  @@map("plans")
}

model PlanLimits {
  id                String @id @default(dbgenerated("uuidv7()")) @db.Uuid
  planId            String @unique @map("plan_id") @db.Uuid
  appointmentLimit  Int    @default(-1) @map("appointment_limit")
  emailLimit        Int    @default(0) @map("email_limit")
  professionalLimit Int    @default(1) @map("professional_limit")
  whatsappLimit     Int    @default(0) @map("whatsapp_limit")
  plan              Plan   @relation(fields: [planId], references: [id])

  @@map("plan_limits")
}

model PlanStats {
  id                String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  planId            String   @map("plan_id") @db.Uuid
  date              DateTime @db.Date
  newSubscribers    Int      @default(0) @map("new_subscribers")
  canceledToday     Int      @default(0) @map("canceled_today")
  revenueToday      Decimal  @default(0) @map("revenue_today") @db.Decimal(12, 2)
  activeSubscribers Int      @default(0) @map("active_subscribers")
  totalRevenue      Decimal  @default(0) @map("total_revenue") @db.Decimal(12, 2)
  updatedAt         DateTime @updatedAt
  plan              Plan     @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@unique([planId, date])
  @@index([date])
  @@map("plan_stats")
}

model Payment {
  id                  String        @id @default(dbgenerated("uuidv7()")) @db.Uuid
  businessId          String        @map("business_id") @db.Uuid
  subscriptionId      String?       @map("subscription_id") @db.Uuid
  referenceCode       String        @unique @map("reference_code")
  sequenceNumber      Int           @unique @map("sequence_number")
  status              PaymentStatus @default(PENDING)
  statusDetails       String?       @map("status_details")
  transactionAmount   Decimal       @map("transaction_amount") @db.Decimal(10, 2)
  netReceivedAmount   Decimal       @map("net_received_amount") @db.Decimal(10, 2)
  transactionCurrency String        @default("UYU") @map("transaction_currency")
  issuedAt            DateTime      @default(now()) @map("issued_at")
  paidAt              DateTime?     @map("paid_at")
  dueAt               DateTime?     @map("due_at")
  externalId          String        @unique @map("external_id")
  createdAt           DateTime      @default(now()) @map("created_at")
  updatedAt           DateTime      @updatedAt @map("updated_at")
  deletedAt           DateTime?     @map("deleted_at")
  business            Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  subscription        Subscription? @relation(fields: [subscriptionId], references: [id])

  @@index([businessId])
  @@index([status])
  @@map("payments")
}

model PlatformStats {
  id                       String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  date                     DateTime @unique @db.Date
  newBusinessesToday       Int      @default(0) @map("new_businesses_today")
  churnedBusinessesToday   Int      @default(0) @map("churned_businesses_today")
  appointmentsToday        Int      @default(0) @map("appointments_today")
  revenueToday             Decimal  @default(0) @map("revenue_today") @db.Decimal(10, 2)
  mrrLostToday             Decimal  @default(0) @map("mrr_lost_today") @db.Decimal(10, 2)
  costsToday               Decimal  @default(0) @map("costs_today") @db.Decimal(10, 2)
  totalBusinesses          Int      @default(0) @map("total_businesses")
  totalActiveSubscriptions Int      @default(0) @map("total_active_subs")
  mrrTotal                 Decimal  @default(0) @map("mrr_total") @db.Decimal(10, 2)
  notificationsSent        Int      @default(0) @map("notifications_sent")
  notificationsFailed      Int      @default(0) @map("notifications_failed")
  updatedAt                DateTime @updatedAt @map("updated_at")
  createdAt                DateTime @default(now()) @map("created_at")

  @@index([date])
  @@map("platform_stats")
}

model PlatformAdmin {
  id     String             @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId String             @unique @map("user_id") @db.Uuid
  level  PlatformAdminLevel
  user   User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("platform_admins")
}

model WebhookLog {
  id          String        @id @default(dbgenerated("uuidv7()")) @db.Uuid
  provider    String
  requestId   String        @unique @map("request_id")
  type        String
  resourceId  String?       @map("resource_id")
  status      WebhookStatus
  error       String?
  payload     Json?
  receivedAt  DateTime      @default(now()) @map("received_at")
  processedAt DateTime?     @map("processed_at")
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  @@unique([provider, requestId])
  @@index([provider, requestId])
  @@index([status])
  @@index([receivedAt])
  @@map("webhook_logs")
}

