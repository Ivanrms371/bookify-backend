generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                 String              @id @default(dbgenerated("uuidv7()")) @db.Uuid
  name               String
  email              String              @unique
  emailVerifiedAt    DateTime?           @map("email_verified_at")
  phoneNumber        String?
  phoneVerifiedAt    DateTime?           @map("phone_verified_at")
  password           String?
  avatarUrl          String?             @map("avatar_url")
  googleId           String?             @unique @map("google_id")
  lastLoginAt        DateTime?           @map("last_login_at")
  tokenVersion       Int                 @default(0) @map("token_version")
  createdAt          DateTime            @default(now()) @map("created_at")
  updatedAt          DateTime            @updatedAt @map("updated_at")
  phoneCountryCode   String?
  inAppNotifications InAppNotification[]
  memberships        Membership[]
  professional       Professional?
  sessions           Session[]

  @@unique([phoneCountryCode, phoneNumber])
  @@index([email])
  @@index([googleId])
  @@map("users")
}

model Membership {
  id       String         @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId   String         @map("user_id") @db.Uuid
  tenantId String         @map("tenant_id") @db.Uuid
  role     MembershipRole
  isActive Boolean        @default(true) @map("is_active")
  tenant   Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user     User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, tenantId])
  @@index([tenantId])
  @@map("memberships")
}

model Invitation {
  id             String         @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tenantId       String         @map("tenant_id") @db.Uuid
  email          String
  role           MembershipRole @default(STAFF)
  token          String         @unique
  expiresAt      DateTime       @map("expires_at")
  createdAt      DateTime       @default(now()) @map("created_at")
  acceptedAt     DateTime?      @map("accepted_at")
  professionalId String?        @map("professional_id") @db.Uuid
  revokedAt      DateTime?      @map("revoked_at")
  professional   Professional?  @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  tenant         Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([email])
  @@index([professionalId])
  @@map("invitations")
}

model Session {
  id         String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  jti        String    @unique
  deviceId   String    @map("device_id")
  lastUsedAt DateTime? @default(now()) @map("last_used_at")
  revokedAt  DateTime? @map("revoked_at")
  expiresAt  DateTime  @map("expires_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, deviceId])
  @@index([revokedAt])
  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model Verification {
  id            String           @id @default(dbgenerated("uuidv7()")) @db.Uuid
  type          VerificationType
  tokenHash     String?          @unique @map("token_hash")
  codeHash      String?          @map("code_hash")
  attempts      Int              @default(0)
  maxAttempts   Int              @default(3) @map("max_attempts")
  expiresAt     DateTime         @map("expires_at")
  verifiedAt    DateTime?        @map("verified_at")
  lockedAt      DateTime?        @map("locked_at")
  createdAt     DateTime         @default(now()) @map("created_at")
  sentCount     Int              @default(0) @map("sent_count")
  recipientId   String           @map("recipient_id") @db.Uuid
  recipientType RecipientType    @map("recipient_type")
  tenantId      String?          @db.Uuid
  tenant        Tenant?          @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([recipientId, recipientType, type])
  @@index([tokenHash])
  @@map("verifications")
}

model Tenant {
  id                          String                      @id @default(dbgenerated("uuidv7()")) @db.Uuid
  slug                        String?                     @unique
  name                        String?
  type                        TenantType?
  description                 String?
  workspaceType               WorkspaceType?              @map("workspace_type")
  colorTheme                  String?                     @map("color_theme")
  isPublic                    Boolean                     @default(false) @map("is_public")
  isActive                    Boolean                     @default(false) @map("is_active")
  onboardingStatus            OnboardingStatus            @default(BUSINESS_DETAILS) @map("onboarding_status")
  phoneNumber                 String?
  addressLine1                String?                     @map("address_line_1")
  addressLine2                String?                     @map("address_line_2")
  city                        String?
  province                    String?
  country                     String?                     @default("UY")
  logoUrl                     String?                     @map("logo_url")
  logoPublicId                String?                     @map("logo_public_id")
  coverUrl                    String?                     @map("cover_url")
  coverPublicId               String?                     @map("cover_public_id")
  createdAt                   DateTime                    @default(now()) @map("created_at")
  updatedAt                   DateTime                    @updatedAt @map("updated_at")
  deletedAt                   DateTime?                   @map("deleted_at")
  onboardingProfessionalDraft Json?                       @map("onboarding_professional_draft")
  appointments                Appointment[]
  customers                   Customer[]
  inAppNotifications          InAppNotification[]
  invitations                 Invitation[]
  memberships                 Membership[]
  payments                    Payment[]
  professionalLifetimeStats   ProfessionalLifetimeStats[]
  professionalDailyStats      ProfessionalDailyStats[]
  professionalWorkingHours    ProfessionalWorkingHours[]
  professionals               Professional[]
  scheduleExceptions          ScheduleException[]
  services                    Service[]
  subscription                Subscription?
  dailyStats                  TenantDailyStats[]
  lifetimeStats               TenantLifetimeStats?
  settings                    TenantSettings?
  usage                       TenantUsage[]
  tenantWorkingHours          TenantWorkingHours[]
  verifications               Verification[]

  @@map("tenants")
}

model TenantSettings {
  id                        String  @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tenantId                  String  @unique @map("tenant_id") @db.Uuid
  slotIntervalMinutes       Int     @default(30) @map("slot_interval_minutes")
  maxAdvancedDays           Int     @default(30) @map("max_advanced_days")
  minAdvancedMinutes        Int     @default(30) @map("min_advanced_minutes")
  bufferTimeMinutes         Int     @default(0) @map("buffer_time_minutes")
  cancellationWindowMinutes Int     @default(30) @map("cancellation_window_minutes")
  currency                  String  @default("UYU")
  maxPendingApptsPerClient  Int     @default(10) @map("max_pending_appts_per_client")
  requireConfirmation       Boolean @default(false) @map("require_confirmation")
  holidayClosureAutoApply   Boolean @default(false) @map("holiday_closure_auto_apply")
  allowPassiveTimeBooking   Boolean @default(false) @map("allow_passive_time_booking")
  timeZone                  String  @default("America/Montevideo") @map("time_zone")
  tenant                    Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("tenant_settings")
}

model Service {
  id                 String              @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tenantId           String              @map("tenant_id") @db.Uuid
  name               String
  description        String?
  price              Decimal             @db.Decimal(10, 2)
  discountPercentage Int?                @default(0) @map("discount_percentage")
  discountFixed      Decimal?            @default(0) @map("discount_fixed") @db.Decimal(10, 2)
  durationMinutes    Int                 @map("duration_minutes")
  isActive           Boolean             @default(true) @map("is_active")
  displayOrder       Int                 @default(0) @map("display_order")
  createdAt          DateTime            @default(now()) @map("created_at")
  updatedAt          DateTime            @updatedAt @map("updated_at")
  deletedAt          DateTime?           @map("deleted_at")
  imagePublicId      String?             @map("image_public_id")
  imageUrl           String?             @map("image_url")
  appointments       Appointment[]
  assignments        ServiceAssignment[]
  tenant             Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("services")
}

model ServiceAssignment {
  professionalId String       @map("professional_id") @db.Uuid
  serviceId      String       @map("service_id") @db.Uuid
  isActive       Boolean      @default(true) @map("is_active")
  professional   Professional @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  service        Service      @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@id([professionalId, serviceId])
  @@index([professionalId, isActive])
  @@map("service_assigments")
}

model Professional {
  id                  String                          @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId              String?                         @unique @map("user_id") @db.Uuid
  tenantId            String                          @map("tenant_id") @db.Uuid
  slotIntervalMinutes Int                             @default(30) @map("slot_interval_minutes")
  maxAdvancedDays     Int                             @default(30) @map("max_advanced_days")
  minAdvancedMinutes  Int                             @default(30) @map("min_advanced_minutes")
  bio                 String?
  avatarUrl           String?                         @map("avatar_url")
  avatarPublicId      String?                         @map("avatar_public_id")
  isActive            Boolean                         @default(true) @map("is_active")
  createdAt           DateTime                        @default(now()) @map("created_at")
  updatedAt           DateTime                        @updatedAt @map("updated_at")
  deletedAt           DateTime?                       @map("deleted_at")
  colorTheme          String?                         @map("color_theme")
  email               String
  name                String
  phoneCountryCode    String                          @map("phone_country_code")
  phoneNumber         String                          @map("phone_number")
  profession          String?
  appointments        Appointment[]
  invitations         Invitation[]
  lifetimeStats       ProfessionalLifetimeStats?
  stats               ProfessionalDailyStats[]
  workingHours        ProfessionalWorkingHours[]
  tenant              Tenant                          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user                User?                           @relation(fields: [userId], references: [id], onDelete: Cascade)
  exceptions          ScheduleExceptionProfessional[]
  assignments         ServiceAssignment[]

  @@index([tenantId])
  @@map("professionals")
}

model ProfessionalWorkingHours {
  id             String       @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tenantId       String       @map("tenant_id") @db.Uuid
  professionalId String       @map("professional_id") @db.Uuid
  dayOfWeek      Int          @map("day_of_week") @db.SmallInt
  opensAt        Int          @map("opens_at") @db.SmallInt
  closesAt       Int          @map("closes_at") @db.SmallInt
  professional   Professional @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  tenant         Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([professionalId, dayOfWeek])
  @@index([tenantId, dayOfWeek])
  @@index([professionalId])
  @@map("professional_working_hours")
}

model TenantWorkingHours {
  id        String @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tenantId  String @map("tenant_id") @db.Uuid
  dayOfWeek Int    @map("day_of_week") @db.SmallInt
  opensAt   Int    @map("opens_at") @db.SmallInt
  closesAt  Int    @map("closes_at") @db.SmallInt
  tenant    Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, dayOfWeek])
  @@map("tenant_working_hours")
}

model ScheduleException {
  id            String                          @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tenantId      String                          @map("tenant_id") @db.Uuid
  isClosed      Boolean                         @map("is_closed")
  reason        String?
  startDate     DateTime                        @map("start_date")
  endDate       DateTime                        @map("end_date")
  createdAt     DateTime                        @default(now()) @map("created_at")
  blocks        ScheduleExceptionBlock[]
  professionals ScheduleExceptionProfessional[]
  tenant        Tenant                          @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([startDate, endDate])
  @@map("schedule_exceptions")
}

model ScheduleExceptionProfessional {
  scheduleExceptionId String            @map("schedule_exception_id") @db.Uuid
  professionalId      String            @map("professional_id") @db.Uuid
  professional        Professional      @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  scheduleException   ScheduleException @relation(fields: [scheduleExceptionId], references: [id], onDelete: Cascade)

  @@id([scheduleExceptionId, professionalId])
  @@index([professionalId])
  @@map("schedule_exception_professionals")
}

model ScheduleExceptionBlock {
  id                  String            @id @default(dbgenerated("uuidv7()")) @db.Uuid
  scheduleExceptionId String            @map("schedule_exception_id") @db.Uuid
  opensAt             Int               @map("opens_at")
  closesAt            Int               @map("closes_at")
  createdAt           DateTime          @default(now()) @map("created_at")
  scheduleException   ScheduleException @relation(fields: [scheduleExceptionId], references: [id], onDelete: Cascade)

  @@index([scheduleExceptionId])
  @@map("schedule_exception_blocks")
}

model Customer {
  id                    String        @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tenantId              String        @map("tenant_id") @db.Uuid
  phoneCountryCode      String        @default("598") @map("phone_country_code")
  email                 String?
  firstAppointmentAt    DateTime?     @map("first_appointment_at")
  lastAppointmentAt     DateTime?     @map("last_appointment_at")
  totalAppointments     Int           @default(0) @map("total_appointments")
  completedAppointments Int           @default(0) @map("completed_appointments")
  cancelledAppointments Int           @default(0) @map("cancelled_appointments")
  noShowCount           Int           @default(0) @map("no_show_count")
  totalSpent            Decimal       @default(0) @map("total_spent")
  blockedReason         String?       @map("blocked_reason")
  blockedAt             DateTime?     @map("blocked_at")
  createdAt             DateTime      @default(now()) @map("created_at")
  updatedAt             DateTime      @updatedAt @map("updated_at")
  deletedAt             DateTime?     @map("deleted_at")
  name                  String
  emailVerifiedAt       DateTime?     @map("email_verified_at")
  phoneVerifiedAt       DateTime?     @map("phone_verified_at")
  notes                 String?
  phoneNumber           String        @map("phone_number")
  appointments          Appointment[]
  tenant                Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, phoneCountryCode, phoneNumber])
  @@index([tenantId])
  @@index([tenantId, lastAppointmentAt])
  @@index([tenantId, blockedAt])
  @@index([tenantId, deletedAt])
  @@map("customers")
}

model Appointment {
  id                 String             @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tenantId           String             @map("tenant_id") @db.Uuid
  serviceId          String             @map("service_id") @db.Uuid
  customerId         String?            @map("customer_id") @db.Uuid
  professionalId     String             @map("professional_id") @db.Uuid
  status             AppointmentStatus  @default(PENDING)
  customerName       String?            @map("customer_name")
  customerPhone      String?            @map("customer_phone")
  customerEmail      String?            @map("customer_email")
  notes              String?
  internalNotes      String?            @map("internal_notes")
  price              Decimal            @db.Decimal(10, 2)
  discountAmount     Decimal            @default(0) @map("discount_amount") @db.Decimal(10, 2)
  discountFixed      Decimal?           @default(0) @map("discount_fixed") @db.Decimal(10, 2)
  discountPercentage Int?               @default(0) @map("discount_percentage")
  durationMinutes    Int                @map("duration_minutes")
  cancelledAt        DateTime?          @map("cancelled_at")
  cancellationReason String?            @map("cancellation_reason")
  rescheduleCount    Int                @default(0) @map("reschedule_count")
  rescheduleReason   String?            @map("reschedule_reason")
  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @updatedAt @map("updated_at")
  manageToken        String?            @unique @map("manage_token")
  endsAt             DateTime           @map("ends_at")
  startsAt           DateTime           @map("starts_at")
  createdBy          CreatedByType      @default(CUSTOMER) @map("created_by")
  blocks             AppointmentBlock[]
  customer           Customer?          @relation(fields: [customerId], references: [id])
  professional       Professional       @relation(fields: [professionalId], references: [id])
  service            Service            @relation(fields: [serviceId], references: [id])
  tenant             Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@index([tenantId, status, startsAt])
  @@index([tenantId, professionalId, startsAt, endsAt])
  @@map("appointments")
}

model AppointmentBlock {
  id            String      @id @default(dbgenerated("uuidv7()")) @db.Uuid
  appointmentId String      @map("appointment_id") @db.Uuid
  endsAt        DateTime    @map("ends_at")
  startsAt      DateTime    @map("starts_at")
  appointment   Appointment @relation(fields: [appointmentId], references: [id])

  @@index([appointmentId])
  @@map("appointment_blocks")
}

model TenantDailyStats {
  id           String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  date         DateTime @db.Date
  appointments Int      @default(0)
  confirmed    Int      @default(0)
  cancelled    Int      @default(0)
  completed    Int      @default(0)
  noShow       Int      @default(0) @map("no_show")
  revenue      Decimal  @default(0) @db.Decimal(10, 2)
  newCustomers Int      @default(0) @map("new_customers")
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, date])
  @@map("tenant_daily_stats")
}

model TenantLifetimeStats {
  id                String  @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tenantId          String  @unique @map("tenant_id") @db.Uuid
  totalAppointments Int     @default(0) @map("total_appointments")
  totalRevenue      Decimal @default(0) @map("total_revenue") @db.Decimal(12, 2)
  totalCustomers    Int     @default(0) @map("total_customers")
  totalCancelled    Int     @default(0) @map("total_cancelled")
  totalCompleted    Int     @default(0) @map("total_completed")
  totalNoShow       Int     @default(0) @map("total_no_show")
  tenant            Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("tenant_lifetime_stats")
}

model ProfessionalDailyStats {
  id             String       @id @default(dbgenerated("uuidv7()")) @db.Uuid
  professionalId String       @map("professional_member_id") @db.Uuid
  date           DateTime     @db.Date
  revenue        Decimal      @default(0) @db.Decimal(10, 2)
  appointments   Int          @default(0) @map("appointments")
  cancelled      Int          @default(0) @map("cancelled")
  completed      Int          @default(0) @map("completed")
  newCustomers   Int          @default(0) @map("new_customers")
  noShow         Int          @default(0) @map("no_show")
  tenantId       String       @map("tenant_id") @db.Uuid
  professional   Professional @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  tenant         Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([professionalId, date])
  @@index([tenantId, date])
  @@map("professional_stats")
}

model ProfessionalLifetimeStats {
  id                String       @id @default(dbgenerated("uuidv7()")) @db.Uuid
  professionalId    String       @unique @map("professional_member_id") @db.Uuid
  totalRevenue      Decimal      @default(0) @map("total_revenue") @db.Decimal(12, 2)
  totalAppointments Int          @default(0) @map("total_appointments")
  totalCancelled    Int          @default(0) @map("total_cancelled")
  totalCompleted    Int          @default(0) @map("total_completed")
  totalNewCustomers Int          @default(0) @map("total_new_customers")
  totalNoShow       Int          @default(0) @map("total_no_show")
  tenantId          String       @map("tenant_id") @db.Uuid
  professional      Professional @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  tenant            Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, professionalId])
  @@index([tenantId])
  @@map("professional_lifetime_stats")
}

model Notification {
  id            String                 @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tenantId      String?                @map("tenant_id") @db.Uuid
  recipientId   String                 @map("recipient_id")
  recipientType RecipientType          @map("recipient_type")
  type          String
  payload       Json
  createdAt     DateTime               @default(now()) @map("created_at")
  updatedAt     DateTime               @updatedAt @map("updated_at")
  referenceId   String?                @map("reference_id")
  inApp         InAppNotification?
  deliveries    NotificationDelivery[]

  @@index([recipientId])
  @@index([tenantId])
  @@index([referenceId])
  @@map("notifications")
}

model NotificationDelivery {
  id                  String              @id @default(dbgenerated("uuidv7()")) @db.Uuid
  notificationId      String              @map("notification_id") @db.Uuid
  channel             NotificationChannel
  status              NotificationStatus  @default(PENDING)
  errorMessage        String?             @map("error_message")
  sentAt              DateTime?           @map("sent_at")
  runAt               DateTime?           @map("run_at")
  retryCount          Int                 @default(0) @map("retry_count")
  externalReferenceId String?             @map("external_reference_id")
  notification        Notification        @relation(fields: [notificationId], references: [id])
  logs                NotificationLog[]

  @@unique([notificationId, channel])
  @@index([notificationId])
  @@map("notification_deliveries")
}

model InAppNotification {
  id             String       @id @default(dbgenerated("uuidv7()")) @db.Uuid
  notificationId String       @unique @map("notification_id") @db.Uuid
  userId         String       @map("user_id") @db.Uuid
  tenantId       String       @map("tenant_id") @db.Uuid
  title          String
  message        String
  actionUrl      String?      @map("action_url")
  type           String
  readAt         DateTime?    @map("read_at")
  createdAt      DateTime     @default(now()) @map("created_at")
  notification   Notification @relation(fields: [notificationId], references: [id])
  tenant         Tenant       @relation(fields: [tenantId], references: [id])
  user           User         @relation(fields: [userId], references: [id])

  @@index([tenantId])
  @@index([userId, readAt])
  @@map("in_app_notifications")
}

model NotificationLog {
  id           String                @id @default(dbgenerated("uuidv7()")) @db.Uuid
  status       NotificationStatus
  createdAt    DateTime              @default(now()) @map("created_at")
  errorMessage String?               @map("error_message")
  deliveryId   String?               @map("notification_id") @db.Uuid
  delivery     NotificationDelivery? @relation(fields: [deliveryId], references: [id])

  @@map("notification_logs")
}

model TenantUsage {
  id               String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tenantId         String   @map("tenant_id") @db.Uuid
  periodMonth      Int      @map("period_month")
  periodYear       Int      @map("period_year")
  lastResetAt      DateTime @map("last_reset_at")
  updatedAt        DateTime @updatedAt @map("updated_at")
  appointmentCount Int      @default(0) @map("appointment_count")
  appointmentLimit Int      @default(-1) @map("appointment_limit")
  whatsappCount    Int      @default(0) @map("whatsapp_count")
  whatsappLimit    Int      @default(0) @map("whatsapp_limit")
  whatsappCost     Decimal  @default(0) @map("whatsapp_cost") @db.Decimal(6, 4)
  emailCount       Int      @default(0) @map("email_count")
  emailLimit       Int      @default(0) @map("email_limit")
  emailCost        Decimal  @default(0) @map("email_cost") @db.Decimal(6, 4)
  tenant           Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, periodMonth, periodYear])
  @@map("tenant_usages")
}

model Subscription {
  id                  String             @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tenantId            String             @unique @map("tenant_id") @db.Uuid
  planId              String             @map("plan_id")
  status              SubscriptionStatus @default(TRIAL)
  amount              Decimal?           @default(0) @db.Decimal(10, 2)
  billingCycle        BillingCycle?      @map("billing_cycle")
  currentPeriodStart  DateTime?          @map("current_period_start")
  currentPeriodEnd    DateTime?          @map("current_period_end")
  trialEndsAt         DateTime?          @map("trial_ends_at")
  trialStartedAt      DateTime?          @default(now()) @map("trial_started_at")
  cancelledAt         DateTime?          @map("cancelled_at")
  cancelReason        String?            @map("cancel_reason")
  paymentMethod       String?            @map("payment_method")
  paymentProvider     String?            @default("LEMON_SQUEEZY") @map("payment_provider")
  createdAt           DateTime           @default(now()) @map("created_at")
  updatedAt           DateTime           @updatedAt @map("updated_at")
  deletedAt           DateTime?          @map("deleted_at")
  lemonCustomerId     String?            @map("lemon_customer_id")
  lemonSubscriptionId String?            @unique @map("lemon_subscription_id")
  endsAt              DateTime?          @map("ends_at")
  currency            Currency           @default(USD)
  pendingBillingCycle BillingCycle?      @map("pending_billing_cycle")
  planChangeUndoRequestedAt DateTime? @map("plan_change_undo_requested_at")
  pendingPlanId       String?            @map("pending_plan_id")
  planChangesAt       DateTime?          @map("plan_changes_at")
  payments            Payment[]
  tenant              Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, status])
  @@index([planChangesAt])
  @@index([status, currentPeriodEnd])
  @@index([status, trialEndsAt])
  @@index([lemonCustomerId])
  @@map("subscriptions")
}

model Payment {
  id                  String        @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tenantId            String        @map("tenant_id") @db.Uuid
  subscriptionId      String?       @map("subscription_id") @db.Uuid
  referenceCode       String        @unique @map("reference_code")
  sequenceNumber      Int           @unique @map("sequence_number")
  status              PaymentStatus @default(PENDING)
  statusDetails       String?       @map("status_details")
  transactionAmount   Decimal       @map("transaction_amount") @db.Decimal(10, 2)
  netReceivedAmount   Decimal       @map("net_received_amount") @db.Decimal(10, 2)
  transactionCurrency String        @default("UYU") @map("transaction_currency")
  issuedAt            DateTime      @default(now()) @map("issued_at")
  paidAt              DateTime?     @map("paid_at")
  dueAt               DateTime?     @map("due_at")
  externalId          String        @unique @map("external_id")
  createdAt           DateTime      @default(now()) @map("created_at")
  updatedAt           DateTime      @updatedAt @map("updated_at")
  deletedAt           DateTime?     @map("deleted_at")
  invoiceUrl          String?       @map("invoice_url")
  subscription        Subscription? @relation(fields: [subscriptionId], references: [id])
  tenant              Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([status])
  @@index([tenantId, issuedAt, id])
  @@map("payments")
}

model PlatformStats {
  id                       String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  date                     DateTime @unique @db.Date
  newTenantesToday         Int      @default(0) @map("new_tenantes_today")
  churnedTenantesToday     Int      @default(0) @map("churned_tenantes_today")
  appointmentsToday        Int      @default(0) @map("appointments_today")
  revenueToday             Decimal  @default(0) @map("revenue_today") @db.Decimal(10, 2)
  mrrLostToday             Decimal  @default(0) @map("mrr_lost_today") @db.Decimal(10, 2)
  costsToday               Decimal  @default(0) @map("costs_today") @db.Decimal(10, 2)
  totalTenantes            Int      @default(0) @map("total_tenantes")
  totalActiveSubscriptions Int      @default(0) @map("total_active_subs")
  mrrTotal                 Decimal  @default(0) @map("mrr_total") @db.Decimal(10, 2)
  notificationsSent        Int      @default(0) @map("notifications_sent")
  notificationsFailed      Int      @default(0) @map("notifications_failed")
  updatedAt                DateTime @updatedAt @map("updated_at")
  createdAt                DateTime @default(now()) @map("created_at")

  @@index([date])
  @@map("platform_stats")
}

model WebhookLog {
  id          String        @id @default(dbgenerated("uuidv7()")) @db.Uuid
  provider    String
  requestId   String        @unique @map("request_id")
  type        String
  resourceId  String?       @map("resource_id")
  status      WebhookStatus
  error       String?
  payload     Json?
  receivedAt  DateTime      @default(now()) @map("received_at")
  processedAt DateTime?     @map("processed_at")
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  @@unique([provider, requestId])
  @@index([provider, requestId])
  @@index([status])
  @@index([receivedAt])
  @@map("webhook_logs")
}

